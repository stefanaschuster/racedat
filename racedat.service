[Unit]
Description=Racedat lap_compare webserver
After=network.target

[Service]
Type=simple
User=racedat
Group=racedat
WorkingDirectory=/opt/lap_compare/lap_tool
ExecStart=/usr/bin/python3 webserver.py --host 127.0.0.1 --http-port 8000 --data /var/lap_compare
Restart=always
RestartSec=3

# Hardening (optional, aber empfehlenswert)
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lap_compare
ProtectHome=true

[Install]
WantedBy=multi-user.target
